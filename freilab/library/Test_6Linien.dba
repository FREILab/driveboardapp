#0000e3\"/>\n    <line x1=\"12\" y1=\"-2.5\" x2=\"12\" y2=\"2.5\" stroke=\"#ffff00\"/>\n    <line x1=\"15\" y1=\"-2.5\" x2=\"15\" y2=\"2.5\" stroke=\"#e21fc3\"/>\n  </g>\n  <!-- instruction text: black, no pass tag, so it is neither cut nor run -->\n  <text x=\"135\" y=\"56.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">Materialtest:</text>\n  <text x=\"135\" y=\"89.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">Zum testen des Strahlprofils im Material. Schneidet 6 vertikale</text>\n  <text x=\"135\" y=\"122.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">Linien (L\u00e4nge: 5 mm, horizontaler Abstand: 3 mm)</text>\n  <text x=\"135\" y=\"155.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">T\u00fcrkis {{round(vmax - (vmax - vmin) * 0 / 5)}}, Rot {{round(vmax - (vmax - vmin) * 1 / 5)}}, Gr\u00fcn {{round(vmax - (vmax - vmin) * 2 / 5)}},</text>\n  <text x=\"135\" y=\"188.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">Blau {{round(vmax - (vmax - vmin) * 3 / 5)}}, Gelb {{round(vmax - (vmax - vmin) * 4 / 5)}}, Pink {{round(vmax - (vmax - vmin) * 5 / 5)}} mm/min bei {{round(p)}} %</text>\n  <text x=\"135\" y=\"221.7\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"26\">(0,0) muss auf der horizontalen Oberkante Liegen:</text>\n</svg>\n"}}