lines of 5 mm, 3 mm apart, centred on y=0 so (0,0) is the workpiece top edge -->\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v1:2000:100:6000:Vorschub T\u00fcrkis=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v2:1900:100:6000:Vorschub Rot=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v3:1800:100:6000:Vorschub Gr\u00fcn=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v4:1700:100:6000:Vorschub Blau=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v5:1600:100:6000:Vorschub Gelb=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:v6:1500:100:6000:Vorschub Pink=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=param:p:100:1:100:Leistung %=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass1:{{round(v1)}}:{{round(p)}}:#00ffff=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass2:{{round(v2)}}:{{round(p)}}:#e50000=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass3:{{round(v3)}}:{{round(p)}}:#00e500=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass4:{{round(v4)}}:{{round(p)}}:#0000e3=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass5:{{round(v5)}}:{{round(p)}}:#ffff00=</text>\n  <text x=\"0\" y=\"1\" font-size=\"2\">=pass6:{{round(v6)}}:{{round(p)}}:#e21fc3=</text>\n  <g fill=\"none\" stroke-width=\"0.1\">\n    <line x1=\"0\" y1=\"-2.5\" x2=\"0\" y2=\"2.5\" stroke=\"#00ffff\"/>\n    <line x1=\"3\" y1=\"-2.5\" x2=\"3\" y2=\"2.5\" stroke=\"#e50000\"/>\n    <line x1=\"6\" y1=\"-2.5\" x2=\"6\" y2=\"2.5\" stroke=\"#00e500\"/>\n    <line x1=\"9\" y1=\"-2.5\" x2=\"9\" y2=\"2.5\" stroke=\"#0000e3\"/>\n    <line x1=\"12\" y1=\"-2.5\" x2=\"12\" y2=\"2.5\" stroke=\"#ffff00\"/>\n    <line x1=\"15\" y1=\"-2.5\" x2=\"15\" y2=\"2.5\" stroke=\"#e21fc3\"/>\n  </g>\n  <!-- instruction layer: black and brown, no pass tag, so it is neither cut nor run.\n       Kept small (x 25..200, y 3..120 mm; text 5.5 mm high) and next to the lines so the work-area check stays quiet.\n       The placement diagram below was traced from the old drawing and scaled by 0.24. -->\n  <text x=\"25\" y=\"7.5\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">Materialtest:</text>\n  <text x=\"25\" y=\"15.4\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">Zum testen des Strahlprofils im Material. Schneidet 6 vertikale</text>\n  <text x=\"25\" y=\"23.3\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">Linien (L\u00e4nge: 5 mm, horizontaler Abstand: 3 mm)</text>\n  <text x=\"25\" y=\"31.2\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">T\u00fcrkis {{round(v1)}}, Rot {{round(v2)}}, Gr\u00fcn {{round(v3)}},</text>\n  <text x=\"25\" y=\"39.2\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">Blau {{round(v4)}}, Gelb {{round(v5)}}, Pink {{round(v6)}} mm/min bei {{round(p)}} %</text>\n  <text x=\"25\" y=\"47.1\" fill=\"#000000\" font-family=\"DejaVu Sans\" font-size=\"5.5\">(0,0) muss auf der horizontalen Oberkante liegen:</text>\n  <g fill=\"none\" stroke=\"#000000\" stroke-width=\"0.1\">\n    <path d=\"M94.17,59.4 L94.17,75.0\"/>\n    <path d=\"M99.6,75.0 L99.6,59.4\"/>\n    <path d=\"M88.73,59.4 L88.73,75.0\"/>\n    <path d=\"M85.61,79.18 L84.61,82.81 L85.63,81.76 L86.68,82.79 L85.61,79.18\"/>\n    <path d=\"M85.62,79.97 L86.23,82.05 L85.63,81.46 L85.04,82.06 L85.62,79.97\"/>\n    <path d=\"M86.03,80.63 L85.22,80.64 L85.34,95.86 L86.16,95.85 L86.03,80.63\"/>\n    <path d=\"M85.63,81.61 L86.45,82.42 L85.62,79.57 L84.82,82.43 L85.63,81.61\"/>\n    <path d=\"M83.3,75.0 L83.3,59.4\"/>\n    <path d=\"M77.87,59.4 L77.87,75.0\"/>\n    <path d=\"M72.43,75.0 L72.43,59.4\"/>\n    <path d=\"M73.4,67.23 L73.4,67.32 L73.38,67.42 L73.36,67.51 L73.33,67.6 L73.29,67.69 L73.24,67.77 L73.18,67.85 L73.11,67.92 L73.04,67.98 L72.97,68.04 L72.88,68.09 L72.8,68.13 L72.71,68.17 L72.61,68.19 L72.52,68.2 L72.42,68.21 L72.33,68.2 L72.23,68.19 L72.14,68.17 L72.05,68.13 L71.96,68.09 L71.88,68.04 L71.8,67.98 L71.73,67.92 L71.66,67.85 L71.61,67.77 L71.56,67.69 L71.52,67.6 L71.